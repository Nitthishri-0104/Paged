DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paged_dev?schema=public"

# Secret used to sign session JWTs. Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Optional: enables real AI tag suggestions and the "Ask AI" chat via Google
# Gemini's free tier (https://aistudio.google.com/apikey). Leave unset to use
# the built-in keyword-frequency heuristic for tag suggestions instead, and to
# hide the AI chat button.
GEMINI_API_KEY=""

# Optional: enables the "Continue with Google" button. Create an OAuth Client ID
# (type: Web application) at https://console.cloud.google.com/apis/credentials, and
# add http://localhost:3000/api/auth/google/callback (plus your deployed URL's
# equivalent) under "Authorized redirect URIs". Leave both unset to hide the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
